VOL_WARMUP_CALENDAR_DAYS = 60     # extra history fetched before BACKTEST_START so realized vol exists on day 1
REALIZED_VOL_WINDOW = 20          # trading days used for the rolling annualized volatility proxy
RISK_FREE_RATE = 0.05

STARTING_CAPITAL = 2_400_000.0  # lump cash sum, per user request, treated as available on 7/5/2022
MAX_CONCURRENT_POSITIONS = 5
NEW_POSITION_CAPITAL_PCT = 0.05
OTM_OFFSET_PCT = 0.02
EXPIRY_CALENDAR_DAYS = 30
TRADING_DAYS_PER_CALENDAR_DAY = 1 / 1.45   # rough US-market trading-day density, used to convert calendar-day expiry to a bar index offset

TAKE_PROFIT_PCT = 0.50
STOP_LOSS_MULTIPLE = 2.0
MAX_DAILY_DRAWDOWN_PCT = 0.02
MAX_DAILY_MARKUP_PCT = 0.03


        chain_search.secType = "OPT"
        chain_search.exchange = "SMART"
        chain_search.currency = "USD"
        chain_search.lastTradeDateOrContractMonth = "202609"
        chain_search.right = "C"
        # strike intentionally left unset -> returns every available strike

        print("🔍 Pulling full SPY Sept-2026 call chain (contract lookup, no market data needed)...")
        self.reqContractDetails(reqId=10, contract=chain_search)

        self.check_market_clock()

    BENIGN_INFO_CODES = {1100, 1101, 1102, 2103, 2104, 2105, 2106, 2107, 2108, 2119, 2137, 2158}


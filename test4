# 🧮 STEP 2: PURE PYTHON BLACK-SCHOLES MATH
def pure_python_norm_cdf(x):
    return (1.0 + math.erf(x / math.sqrt(2.0))) / 2.0

def calculate_black_scholes_value(stock_price, strike, days_to_expiry, risk_free_rate, volatility):
    if stock_price <= 0 or strike <= 0 or days_to_expiry <= 0 or volatility <= 0:
        return 0.0
    T = days_to_expiry / 365.0
    d1 = (math.log(stock_price / strike) + (risk_free_rate + 0.5 * volatility ** 2) * T) / (volatility * math.sqrt(T))
    d2 = d1 - volatility * math.sqrt(T)
    call_price = stock_price * pure_python_norm_cdf(d1) - strike * math.exp(-risk_free_rate * T) * pure_python_norm_cdf(d2)
    return round(call_price, 2)


# 🕒 DELAYED-DATA-AWARE TICK TYPE GROUPS
# TWS/Gateway may deliver either the "live" tick codes (1/2/4/9) or the
# "delayed" codes (66/67/68/75) depending on account entitlements and
# whether reqMarketDataType(3) fallback actually kicked in. We accept both
# so the engine never stalls waiting on a code that never arrives.
BID_TICKS = {1, 66}          # BID, DELAYED_BID
ASK_TICKS = {2, 67}          # ASK, DELAYED_ASK
LAST_TICKS = {4, 68}         # LAST, DELAYED_LAST
CLOSE_TICKS = {9, 75}        # CLOSE, DELAYED_CLOSE (fallback when no live/last tick streams)

# 📁 LOCAL STATE FILES (adjust paths as needed)
TRADE_LOG_PATH = r"C:\Users\Brandon.R\trade_log.txt"
SESSION_HISTORY_PATH = r"C:\Users\Brandon.R\engine_session_history.json"


class RiskProtectedEngine(EWrapper, EClient):
    def __init__(self):
        EClient.__init__(self, self)
        self.next_order_id = None
        self.live_stock_price = 0.0
        self.live_option_ask = 0.0
        self.live_option_bid = 0.0
        self.contract_resolved = False
        self.has_executed = False  
        self.heartbeat_count = 0
        
        # 🛡️ POSITION STATUS INDICATORS
        self.position_active = False
        self.entry_price = 0.0
        self.take_profit_target = 0.0
        self.stop_loss_target = 0.0
        self.position_quantity = 0

        # 📏 POSITION SIZING (risk-based, self-scaling with account capital)
        # Risk a fixed % of CURRENT capital per trade, sized off the existing
        # 10% stop-loss distance below, rather than a flat contract count.
        self.risk_per_trade_pct = 0.01  # 1% of capital at risk per trade — tune as desired
        
        # 📈 PERFORMANCE TRACKING STATS
        # No more hardcoded balance — pulled live from the account at startup.
        self.starting_balance = 0.0
        self.closing_balance = 0.0
        self.account_balance_ready = False   # gate: don't trade until we know real capital
        self.total_trades = 0
        self.wins = 0
        self.session_history = self.load_session_history()
        
        # 🚨 RISK PARAMETER BOUNDARIES
        self.max_daily_drawdown_pct = 0.02  # 2% Max Loss Limit (of TODAY's actual cash)
        self.max_daily_markup_pct = 0.03    # 3% Max Profit Cap (of TODAY's actual cash)
        self.system_halted = False          # Global circuit breaker latch

    # ---------------------------------------------------------------
    # SESSION HISTORY PERSISTENCE
    # ---------------------------------------------------------------
    def load_session_history(self):
        if not os.path.exists(SESSION_HISTORY_PATH):
            return []
        try:
            with open(SESSION_HISTORY_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, OSError):
            return []

    def save_session_history(self):
        try:
            with open(SESSION_HISTORY_PATH, "w", encoding="utf-8") as f:
                json.dump(self.session_history, f, indent=2)
        except OSError as e:
            print(f"⚠️ Could not write session history: {e}")

    def append_todays_session(self):
        entry = {
            "date": datetime.datetime.now().strftime("%Y-%m-%d"),
            "starting_cash": self.starting_balance,
            "closing_cash": self.closing_balance,
            "trades": self.total_trades,
            "wins": self.wins,
            "net_pl": round(self.closing_balance - self.starting_balance, 2),
        }
        self.session_history.append(entry)
        self.save_session_history()

    # ---------------------------------------------------------------
    # IB CALLBACKS
    # ---------------------------------------------------------------
    def nextValidId(self, orderId: int):
        self.next_order_id = orderId
        print(f"🎉 RISK-PROTECTED ENGINE ONLINE. ACTIVE ID: {self.next_order_id}")
        self.reqMarketDataType(3)  # 3 = Delayed data
        self.write_to_notepad("SYSTEM UPDATE: Trading Engine launched with Maximum Drawdown & Markup circuit breakers active.")

        # --- FETCH REAL AVAILABLE CASH FROM THE PAPER ACCOUNT ---
        # TotalCashValue = actual cash sitting in the account, excluding the
        # current market value of any open stock/option holdings.
        print("💳 Requesting current account cash balance...")
        self.reqAccountSummary(9001, "All", "TotalCashValue")

        # --- STEP 1: INITIAL DATA STREAM FOR UNDERLYING STOCK ---
        spy_stock = Contract()
        spy_stock.symbol = "SPY"
        spy_stock.secType = "STK"
        spy_stock.exchange = "SMART"
        spy_stock.currency = "USD"
        # primaryExchange intentionally left unset (SMART resolves it). Note:
        # if you still see error 10089 ("SPY ARCA/TOP/ALL") with this unset,
        # it's not a routing artifact — it means the account genuinely lacks
        # the free delayed-data subscription for API access. That has to be
        # enabled in Client Portal > Market Data Subscriptions, not fixed here.

        print("📡 Booting Eye 1: Streaming underlying stock prices (delayed mode)...")
        self.reqMktData(reqId=1, contract=spy_stock, genericTickList="", snapshot=False, regulatorySnapshot=False, mktDataOptions=[])
        
        self.check_market_clock()

    # IB sends these on every connect just to report farm status — they say
    # "connection is OK" but get shouted through error() anyway. Suppress them
    # from the warning stream so real problems (like 10089) don't get buried.
    BENIGN_INFO_CODES = {1100, 1101, 1102, 2103, 2104, 2105, 2106, 2107, 2108, 2119, 2137, 2158}

    def error(self, reqId, errorCode, errorString, advancedOrderRejectJson=""):
        if errorCode in self.BENIGN_INFO_CODES:
            print(f"ℹ️ [{errorCode}] {errorString}")
            return
        # Useful codes to watch for on market data requests:
        #   10167 = "Displaying delayed market data" -> informational, NOT a blocker
        #   354, 10089, 10090, 10091, 2152 -> genuine "no permission" for that
        #     specific feed (equity vs OPRA options are separate grants;
        #     10089 = account lacks the delayed-data subscription entirely,
        #     fix in Client Portal > Market Data Subscriptions, not in code)
        msg = f"⚠️ IB ERROR [reqId={reqId}] Code {errorCode}: {errorString}"
        print(msg)
        self.write_to_notepad(msg)

    def marketDataType(self, reqId: int, marketDataType: int):
        # TWS confirms what data mode it actually granted per request.
        # 1=Live, 2=Frozen, 3=Delayed, 4=Delayed Frozen
        mode_labels = {1: "LIVE", 2: "FROZEN", 3: "DELAYED", 4: "DELAYED FROZEN"}
        label = mode_labels.get(marketDataType, f"UNKNOWN({marketDataType})")
        msg = f"📶 Market data mode confirmed for reqId {reqId}: {label}"
        print(msg)
        self.write_to_notepad(msg)

    def accountSummary(self, reqId, account, tag, value, currency):
        if tag != "TotalCashValue":
            return
        # Visibility: shows exactly what currency labels IB is sending back,
        # so if something's still off it's obvious from the console instead
        # of guessing.
        print(f"🧾 accountSummary received: tag={tag} currency={currency} value={value}")

        # Some accounts (esp. single-currency paper accounts) never send a
        # "BASE" aggregate row, only a plain "USD" row. Accept the first
        # value we get regardless of currency so the engine isn't stuck
        # waiting forever, but let a later "BASE" row (the correct aggregate
        # for multi-currency accounts) overwrite it if one does show up.
        if currency == "BASE" or not self.account_balance_ready:
            self.starting_balance = float(value)
            self.closing_balance = self.starting_balance
            self.account_balance_ready = True
            msg = f"💰 LIVE ACCOUNT CASH LOADED: ${self.starting_balance:,.2f} (account {account}, currency={currency}) — today's real starting capital."
            print(msg)
            self.write_to_notepad(msg)

    def accountSummaryEnd(self, reqId):
        if not self.account_balance_ready:
            warn = (
                "⚠️ accountSummaryEnd fired but no TotalCashValue was ever received. "
                "Check: (1) TWS API settings aren't set to a mode blocking account data, "
                "(2) no other client/master session is already bound to this account's "
                "updates, (3) the paper account is actually logged in and not just the "
                "API socket connected."
            )
            print(warn)
            self.write_to_notepad(warn)
        self.cancelAccountSummary(reqId)

    def check_market_clock(self):
        now = datetime.datetime.now()
        
        # 🚨 THE 3:50 PM FORCE-EXIT PANIC SWITCH
        if now.hour == 15 and now.minute >= 50 and self.position_active:
            self.write_to_notepad("⚠️ EOD FLAT RULE TRIGGERED: Forcing instant market exit before close...")
            print("\n⚠️ EOD FLAT RULE TRIGGERED: Clearing book to zero cash...")
            self.trigger_sell_order_payload()
        
        # 🛑 THE 4:00 PM CLOSING BELL SHUTDOWN
        if now.hour >= 16:
            self.shutdown_engine()
            return
            
        self.heartbeat_count += 1
        if self.heartbeat_count >= 60:
            self.heartbeat_count = 0
            status_text = "Halted" if self.system_halted else ("Position Open" if self.position_active else "Scanning Market")
            balance_status = f"${self.starting_balance:,.2f}" if self.account_balance_ready else "awaiting account data..."
            print(f"💓 [HEARTBEAT {now.strftime('%I:%M %p')}] Engine online. Mode: {status_text}. Capital: {balance_status}")

        threading.Timer(1.0, self.check_market_clock).start()

    def tickPrice(self, reqId: int, tickType: int, price: float, attrib):
        # If the system circuit breaker is tripped, reject all incoming prices immediately!
        if price <= 0 or self.system_halted:
            return

        # DATA ROUTER LAYER — accepts live OR delayed tick codes, with a
        # DELAYED_CLOSE / CLOSE fallback so a quiet/thin contract doesn't
        # leave live_option_ask/live_stock_price stuck at 0 forever.
        if reqId == 1:
            if tickType in LAST_TICKS:
                self.live_stock_price = price
            elif tickType in CLOSE_TICKS and self.live_stock_price == 0.0:
                self.live_stock_price = price  # fallback only if nothing better has arrived yet

            if self.live_stock_price > 0 and not self.contract_resolved:
                self.contract_resolved = True
                self.resolve_dynamic_option_contract()

        elif reqId == 2:
            if tickType in ASK_TICKS:
                self.live_option_ask = price
            elif tickType in BID_TICKS:
                self.live_option_bid = price
            elif tickType in CLOSE_TICKS:
                # Only use close as a last-resort seed for whichever side is still empty
                if self.live_option_ask == 0.0:
                    self.live_option_ask = price
                if self.live_option_bid == 0.0:
                    self.live_option_bid = price

        # EVALUATION ROUTER — gated on account_balance_ready so we never
        # trade before we actually know today's real capital.
        if not self.account_balance_ready:
            return
        if not self.has_executed and self.live_stock_price > 0 and self.live_option_ask > 0:
            self.evaluate_and_execute()
        elif self.position_active and self.live_option_bid > 0:
            self.monitor_exit_targets()

    def resolve_dynamic_option_contract(self):
        dynamic_strike = round(self.live_stock_price / 5.0) * 5.0
        search_option = Contract()
        search_option.symbol = "SPY"
        search_option.secType = "OPT"
        search_option.exchange = "SMART"
        search_option.currency = "USD"
        search_option.lastTradeDateOrContractMonth = "202609" 
        search_option.strike = float(dynamic_strike)
        search_option.right = "C"
        
        print(f"🔍 Dynamic Search Initiated: Querying database for ${dynamic_strike} Call options...")
        self.reqContractDetails(reqId=10, contract=search_option)

    def contractDetails(self, reqId: int, contractDetails):
        if reqId == 10:
            self.target_option = contractDetails.contract
            msg = f"CONTRACT ATTACHED: Eye 2 locked onto {self.target_option.localSymbol}"
            print(f"✅ {msg}")
            self.write_to_notepad(msg)
            self.reqMarketDataType(3)  # re-assert delayed mode before the new subscription
            self.reqMktData(reqId=2, contract=self.target_option, genericTickList="", snapshot=False, regulatorySnapshot=False, mktDataOptions=[])

    def calculate_position_size(self):
        """Risk-based sizing: how many contracts can we buy such that if the
        existing 10% stop-loss is hit, the dollar loss stays within
        risk_per_trade_pct of CURRENT capital? Capped by what we can
        actually afford outright. Returns 0 if even 1 contract fails either check."""
        if self.live_option_ask <= 0:
            return 0

        stop_distance_per_share = self.live_option_ask * 0.10  # matches stop_loss_target math
        loss_per_contract = stop_distance_per_share * 100.0    # options = 100 shares/contract
        if loss_per_contract <= 0:
            return 0

        dollar_risk_budget = self.closing_balance * self.risk_per_trade_pct
        risk_based_qty = math.floor(dollar_risk_budget / loss_per_contract)

        cost_per_contract = self.live_option_ask * 100.0
        affordable_qty = math.floor(self.closing_balance / cost_per_contract) if cost_per_contract > 0 else 0

        return max(0, min(risk_based_qty, affordable_qty))

    def evaluate_and_execute(self):
        days_left = 8.0
        interest_rate = 0.05
        dynamic_vol = 0.22 
        
        theoretical_value = calculate_black_scholes_value(
            self.live_stock_price, self.target_option.strike, 
            days_left, interest_rate, dynamic_vol
        )
        
        if self.live_option_ask < theoretical_value:
            quantity = self.calculate_position_size()
            if quantity < 1:
                # Signal is valid but sizing rounds to zero (e.g. risk budget
                # too small for even 1 contract at current prices) — skip and
                # keep scanning rather than forcing a trade we can't size safely.
                skip_msg = f"⏭️ SIGNAL FOUND but sized to 0 contracts (risk budget ${self.closing_balance * self.risk_per_trade_pct:,.2f} vs ask ${self.live_option_ask}). Skipping."
                print(skip_msg)
                self.write_to_notepad(skip_msg)
                return

            self.has_executed = True
            alert = f"💥 SIGNAL MATCH FOUND! SPY Stock: ${self.live_stock_price} | Option Ask: ${self.live_option_ask} | Calculated Fair Value: ${theoretical_value} | Sizing: {quantity} contract(s)"
            print(f"\n{alert}")
            self.write_to_notepad(alert)
            self.trigger_buy_order_payload(quantity)

    def trigger_buy_order_payload(self, quantity):
        self.write_to_notepad(f"ORDER ROUTING: Submitting automated limit buy transaction for {quantity} contract(s)...")
        buy_order = Order()
        buy_order.action = "BUY"
        buy_order.orderType = "LMT"
        buy_order.totalQuantity = quantity
        buy_order.lmtPrice = self.live_option_ask
        buy_order.transmit = True
        self.placeOrder(self.next_order_id, self.target_option, buy_order)

    def orderStatus(self, orderId: int, status: str, filled: float, remaining: float, avgFillPrice: float, permId: int, parentId: int, lastFillPrice: float, clientId: int, whyHeld: str, mktCapPrice: float):
        if status == "Filled" and not self.position_active and orderId == self.next_order_id:
            self.position_active = True
            self.entry_price = avgFillPrice
            self.position_quantity = int(filled)
            self.take_profit_target = round(self.entry_price * 1.20, 2)
            self.stop_loss_target = round(self.entry_price * 0.90, 2)
            self.total_trades += 1
            
            fill_msg = f"📦 POSITION OPENED! Qty: {self.position_quantity} | Fill Price: ${self.entry_price} | TP Target: ${self.take_profit_target} | SL Target: ${self.stop_loss_target}"
            print(f"\n{fill_msg}")
            self.write_to_notepad(fill_msg)

    def monitor_exit_targets(self):
        # Target Check 1: Single Trade Take Profit Hit
        if self.live_option_bid >= self.take_profit_target:
            self.position_active = False
            msg = f"💰 TAKE PROFIT TRIGGERED! Market Bid is ${self.live_option_bid} >= Target ${self.take_profit_target}"
            print(f"\n{msg}")
            self.write_to_notepad(msg)
            self.wins += 1
            
            trade_gain = round((self.live_option_bid - self.entry_price) * 100.0 * self.position_quantity, 2)
            self.closing_balance += trade_gain
            self.trigger_sell_order_payload()
            self.check_global_account_risk() 
            
        # Target Check 2: Single Trade Stop Loss Hit
        elif self.live_option_bid <= self.stop_loss_target:
            self.position_active = False
            msg = f"⚠️ STOP LOSS TRIGGERED! Market Bid is ${self.live_option_bid} <= Target ${self.stop_loss_target}"
            print(f"\n{msg}")
            self.write_to_notepad(msg)
            
            trade_loss = round((self.entry_price - self.live_option_bid) * 100.0 * self.position_quantity, 2)
            self.closing_balance -= trade_loss
            self.trigger_sell_order_payload()
            self.check_global_account_risk() 

    # 🛑 THE GLOBAL ACCOUNT RISK CIRCUIT BREAKER
    def check_global_account_risk(self):
        current_net_change_pct = (self.closing_balance - self.starting_balance) / self.starting_balance
        
        if current_net_change_pct <= -self.max_daily_drawdown_pct:
            self.system_halted = True
            halt_msg = f"🚨 RISK EMERGENCY: MAXIMUM DRAWDOWN BREACHED ({current_net_change_pct*100:.1f}%). TRADING HALTED TO PRESERVE CAPITAL."
            print(f"\n{halt_msg}")
            self.write_to_notepad(halt_msg)
            
        elif current_net_change_pct >= self.max_daily_markup_pct:
            self.system_halted = True
            halt_msg = f"📈 TARGET ACHIEVED: MAXIMUM DAILY MARKUP REACHED (+{current_net_change_pct*100:.1f}%). LOCKING IN PROFIT AND CLOSING SESSION."
            print(f"\n{halt_msg}")
            self.write_to_notepad(halt_msg)

    def trigger_sell_order_payload(self):
        self.next_order_id += 1
        self.write_to_notepad(f"ORDER ROUTING: Transmitting market exit payload for {self.position_quantity} contract(s)...")
        sell_order = Order()
        sell_order.action = "SELL"
        sell_order.orderType = "MKT"
        sell_order.totalQuantity = self.position_quantity
        sell_order.transmit = True
        self.placeOrder(self.next_order_id, self.target_option, sell_order)
        print("🏁 Exit transaction complete. Position closed cleanly.")
        self.position_quantity = 0

    def write_to_notepad(self, text_to_log):
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        formatted_line = f"[{timestamp}] {text_to_log}\n"
        with open(TRADE_LOG_PATH, "a", encoding="utf-8") as file:
            file.write(formatted_line)

    def shutdown_engine(self):
        win_rate = (self.wins / self.total_trades * 100.0) if self.total_trades > 0 else 0.0
        net_pl = round(self.closing_balance - self.starting_balance, 2)
        pl_prefix = "+" if net_pl >= 0 else ""

        # Persist today's results so tomorrow's session has a running history.
        # (Tomorrow's actual STARTING CASH still comes fresh from the broker
        # via reqAccountSummary — this log is for your own record-keeping /
        # cumulative stats, not for seeding next session's balance.)
        self.append_todays_session()

        lifetime_trades = sum(s["trades"] for s in self.session_history)
        lifetime_wins = sum(s["wins"] for s in self.session_history)
        lifetime_win_rate = (lifetime_wins / lifetime_trades * 100.0) if lifetime_trades > 0 else 0.0

        summary_block = (
            "\n==================================================\n"
            "🗒️ --- FINAL END-OF-DAY PERFORMANCE SUMMARY ---\n"
            f"📅 Session Date: {datetime.datetime.now().strftime('%Y-%m-%d')}\n"
            f"📦 Total Trades Executed Today: {self.total_trades}\n"
            f"💰 Starting Cash (from account): ${self.starting_balance:,.2f}\n"
            f"📈 Closing Cash (est.): ${self.closing_balance:,.2f}\n"
            f"🟢 Net Profit/Loss Today: {pl_prefix}${net_pl:,.2f}\n"
            f"🌟 Today's Win Rate: {win_rate:.1f}%\n"
            f"📚 Lifetime Trades Logged: {lifetime_trades} | Lifetime Win Rate: {lifetime_win_rate:.1f}%\n"
            "=================================================="
        )
        print(summary_block)
        self.write_to_notepad(summary_block)
        self.cancelMktData(1)
        if hasattr(self, 'target_option'):
            self.cancelMktData(2)
        self.disconnect()

# Launch risk-protected system

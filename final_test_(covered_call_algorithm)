# 🗓️ DYNAMIC EXPIRATION TARGETING — asks IB what expirations are actually
# listed for each symbol right now (reqSecDefOptParams) and picks whichever
# real date lands closest to this many calendar days out, instead of a
# hardcoded contract month. Works the same in any month/year — nothing
# here needs hand-editing as time passes. Lower this (e.g. 7) to bias
# toward weekly expirations instead.
TARGET_DTE_DAYS = 30

MIN_SHARES_FOR_COVER = 100
FALLBACK_VOL = 0.22  # only used if IB hasn't returned a usable impliedVol yet

# 🎯 DELTA-TARGETED STRIKE SELECTION — replaces a flat "X% out of the
# money" rule. 0.25 delta is the common professional convention for
# covered-call writing: roughly a 70-75% probability the option expires
# worthless (i.e. you keep the shares AND the premium), while still
# collecting a meaningful credit. This is solved fresh per symbol from
# that symbol's OWN live implied vol (see solve_strike_for_target_delta),
# so two Mag 7 names with different volatility land at genuinely
# comparable risk levels instead of the same raw % distance from price.
TARGET_DELTA = 0.25

# ⏳ DTE BACKSTOP — a SECOND, independent close trigger alongside profit-
# capture and stop-loss, not a replacement for either. Once a position's
# REMAINING days-to-expiration falls to this fraction of the DTE it had
# when the position was opened (or first discovered, for a pre-existing
# holding), it is force-closed regardless of P&L. This is deliberately
# NOT a fixed day count — it's computed fresh off each position's own
# actual entry DTE every time, so it scales automatically if
# TARGET_DTE_DAYS above is ever changed. The reasoning is capital
# efficiency, not loss avoidance: extrinsic value decay flattens out and
# gamma/pin risk rises in the last stretch before expiration, so capital
# sitting there is capital not compounding in a fresh, steeper part of
# another option's decay curve. At 0.20 off a 30-day entry, this trips
# around 6 days out.
DTE_BACKSTOP_PCT = 0.20

# 🔗 CONCENTRATION — no explicit cap on how many of the 7 Mag 7 names can
# be open at once (previously MAX_CONCURRENT_POSITIONS=4; removed by
# explicit instruction). Reasoning: all 7 names are already one
# correlated cluster, so 4-of-7 vs 7-of-7 doesn't meaningfully change
# correlated exposure — it mostly just left capital idle, which fights
# the "use all available cash" goal. The real risk backstops are per-
# position (self.stop_loss_multiple) and account-wide (cash-solvency
# enforcement below), both independent of how many names are open. If
# the candidate universe is ever widened beyond the Mag 7 to include
# genuinely less-correlated names, a concentration cap would be worth
# reintroducing at that point.

# 🔐 ACCOUNT PERMISSION GATE — Code 201 rejections on standalone sell-to-open
# orders mean this IB account does not currently hold the "sell covered
# calls / options writing" trading-permission strategy tier, even though
# combo (BAG) buy-write orders fill fine under a different permission
# bucket. This is NOT something to route around in code. Go to:
#   Account Management -> Settings -> Trading Permissions -> Options
# and request the strategy tier that covers standalone call writing. Only
# flip this to True once IB has actually confirmed the permission is live
# on the account, otherwise every signal will keep hard-rejecting.
STANDALONE_COVERED_CALL_PERMISSION_GRANTED = False

# 💵 CASH ALLOCATION — each new buy-write gets an EVEN SPLIT of whatever
# cash remains this pass, divided across however many MAX_CONCURRENT_
# POSITIONS slots are still open (see attempt_new_buy_write()). A flat
# percentage of "whatever's left" was tried first and rejected: taking a
# fixed % of a shrinking remainder is a decaying series that asymptotically
# approaches full deployment and never gets there within a few trades,
# which is what left real cash sitting idle. Cash is now split evenly
# now the ONLY concentration control — there is deliberately no separate
# per-trade cap anymore.

# 🛡️ CASH-ONLY ENFORCEMENT — this engine must only ever spend cash it
# actually has, never margin/borrowed buying power. Two independent guards
# enforce this now:
#   1) Every new buy-write order's estimated cost is reserved in
#      self.pending_order_cash the INSTANT the order is submitted (not
#      just earmarked for the current evaluate_new_position_opportunities()
#      pass) and stays reserved until that order's fill is confirmed via
#      execDetails(), or the order is cancelled/rejected. This is what
#      makes cash checks accurate ACROSS heartbeats, not just within a
#      single pass — previously a slow-filling combo order was invisible
#      to the next heartbeat's cash check, so the engine kept opening new
#      positions against cash it had already committed to a still-working
#      order, which is how the account ended up spending on margin.
#   2) enforce_cash_solvency() runs on every accountSummary() cash/excess-
#      liquidity update AND every heartbeat tick. If TotalCashValue or IB's
#      own ExcessLiquidity figure ever goes negative (meaning a fill went
#      through on margin anyway — a broker-side fill/timing edge case this
#      code can't fully prevent from IB's side), it immediately halts ALL
#      new position opening, cancels any still-working buy-write orders,
#      and starts closing existing bot-tracked positions — largest
#      estimated market value first — until both figures are back to
#      >= MIN_CASH_BUFFER.
MIN_CASH_BUFFER = 0.0  # required cash/excess-liquidity floor; raise above 0.0 to keep a safety margin

# 🏁 POSITION HOLD BEHAVIOR — no forced end-of-day flatten. Once a
# buy-write is opened, both legs (long shares + short call) are left in
# place and monitored continuously, including across multi-day/overnight
# runs — existing positions are rediscovered straight from the broker on
# every (re)start via positionEnd(). A position closes ONLY when one of
# three independent triggers fires (see monitor_exit_targets() /
# monitor_leg_exit_targets()):
#   - the profit-capture target (PROFIT_CAPTURE_PCT), or
#   - the stop-loss multiple (self.stop_loss_multiple), or
#   - the DTE backstop (DTE_BACKSTOP_PCT) — force-close regardless of P&L
# There is no other calendar-day/expiration-proximity rule anywhere. At
# market close, shutdown_engine() prints a full portfolio snapshot (see
# build_position_snapshot_lines()) of wherever things stand — it is a
# report, not a liquidation trigger.

# 💰 PROFIT-CAPTURE EXIT TARGET — once a short call's live ask has decayed
# down to (1 - PROFIT_CAPTURE_PCT) of the credit it was originally sold
# for, the position is closed and the engine immediately looks for a new
# opportunity (see recycle_symbol_after_close()). At 0.80, that means
# closing once 80% of that call's maximum possible profit has already
# been captured via time decay — whether that took 3 days or 25.
# __init__() derives self.take_profit_pct from this constant.
PROFIT_CAPTURE_PCT = 0.80


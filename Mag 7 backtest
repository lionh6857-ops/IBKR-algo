# =====================================================================
# BLACK-SCHOLES + DELTA-TARGETED STRIKE SOLVE (identical math to the live
# engine's pure_python_norm_cdf / calculate_black_scholes_value /
# solve_strike_for_target_delta)
# =====================================================================
def pure_python_norm_cdf(x):
    return (1.0 + math.erf(x / math.sqrt(2.0))) / 2.0
 
 
def calculate_black_scholes_value(stock_price, strike, days_to_expiry, risk_free_rate, volatility):
    if stock_price <= 0 or strike <= 0 or days_to_expiry <= 0 or volatility <= 0:
        return 0.0
    T = days_to_expiry / 365.0
    d1 = (math.log(stock_price / strike) + (risk_free_rate + 0.5 * volatility ** 2) * T) / (volatility * math.sqrt(T))
    d2 = d1 - volatility * math.sqrt(T)
    call_price = stock_price * pure_python_norm_cdf(d1) - strike * math.exp(-risk_free_rate * T) * pure_python_norm_cdf(d2)
    return round(call_price, 4)
 
 
def solve_strike_for_target_delta(stock_price, days_to_expiry, risk_free_rate, volatility, target_delta):
    """Analytically solves for the call strike whose Black-Scholes delta
    (~= N(d1)) equals target_delta — same closed-form solve as the live
    engine's finalize_target_contract(), so the backtest picks strikes the
    same way the live engine actually does. Falls back to a flat 2% OTM
    strike (matching the live engine's own fallback) if the solve fails."""
    if stock_price <= 0 or days_to_expiry <= 0 or volatility <= 0:
        return None
    if not (0.0 < target_delta < 1.0):
        return None
    T = days_to_expiry / 365.0
    try:
        d1 = NormalDist().inv_cdf(target_delta)
    except (ValueError, ZeroDivisionError):
        return None
    try:
        strike = stock_price / math.exp(d1 * volatility * math.sqrt(T) - (risk_free_rate + 0.5 * volatility ** 2) * T)
    except (OverflowError, ValueError):
        return None
    return strike if strike > 0 else None
 
 

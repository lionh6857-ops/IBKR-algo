# STAGE 2: OFFLINE SIMULATION (no IBKR connection needed from here on)
# =====================================================================
def compute_realized_vol_series(closes):
    """Rolling REALIZED_VOL_WINDOW-day annualized volatility from daily log
    returns — the proxy standing in for implied volatility, which IBKR
    does not provide historically for expired option chains."""
    vols = [None] * len(closes)
    for i in range(REALIZED_VOL_WINDOW, len(closes)):
        window = closes[i - REALIZED_VOL_WINDOW:i + 1]
        rets = [
            math.log(window[j] / window[j - 1])
            for j in range(1, len(window))
            if window[j - 1] > 0 and window[j] > 0
        ]
        if len(rets) < 2:
            continue
        stdev = statistics.pstdev(rets)
        vols[i] = stdev * math.sqrt(252)
    return vols
 
 
class PositionState:
    def __init__(self):
        self.active = False
        self.shares = 0
        self.contracts = 0
        self.cost_basis_per_share = 0.0
        self.strike = 0.0
        self.entry_credit = 0.0
        self.expiry_day_index = 0          # hard ceiling (real expiration bar index) — safety net only
        self.dte_backstop_day_index = 0    # the trigger that actually closes almost every position
 
 
class Mag7CoveredCallBacktester:
    def __init__(self, price_data):
        self.price_data = price_data
        self.symbol_series = {}
        self.symbol_vol = {}
        self.positions = {sym: PositionState() for sym in price_data}
        self.cash = STARTING_CAPITAL
        self.trade_log = []
        self.equity_curve = []
        self.halted_days = 0
        self._prepare_series()
 
    def _prepare_series(self):
        for sym, bars in self.price_data.items():
            bars_sorted = sorted(bars, key=lambda b: b["date"])
            closes = [b["close"] for b in bars_sorted]
            dates = [b["date"] for b in bars_sorted]
            vols = compute_realized_vol_series(closes)
            self.symbol_series[sym] = list(zip(dates, closes))
            self.symbol_vol[sym] = vols
 
    def run(self):
        start_str = BACKTEST_START.strftime("%Y%m%d")
        end_str = BACKTEST_END.strftime("%Y%m%d")
 
        master_dates = sorted({
            d for sym in self.symbol_series for d, _ in self.symbol_series[sym]
            if start_str <= d <= end_str
        })
        idx_lookup = {
            sym: {d: i for i, (d, _) in enumerate(self.symbol_series[sym])}
            for sym in self.symbol_series
        }
 
        if not master_dates:
            print("⚠️ No trading days found in the requested window — check the cached data.")
            return
 
        start_of_day_equity = self.cash
 
        for day_str in master_dates:
            # ---- 0. DAILY RISK BREAKER — checked FIRST, using today's
            #         marks BEFORE anything else happens that day. This is
            #         the earliest a daily-bar backtest can detect what the
            #         live engine's system_halted flag would catch
            #         intraday. See point 7 in the module docstring: once
            #         breached, self.system_halted freezes ALL market-data
            #         processing in the live engine — new entries AND
            #         managing positions already open — so a halted day
            #         here does neither. ----
            equity_before_management = self._mark_to_market(day_str, idx_lookup)
            halted_today = False
            if start_of_day_equity > 0:
                change_pct = (equity_before_management - start_of_day_equity) / start_of_day_equity
                if change_pct <= -DAILY_DRAWDOWN_HALT_PCT or change_pct >= DAILY_MARKUP_HALT_PCT:
                    halted_today = True
                    self.halted_days += 1
 
            if halted_today:
                self.equity_curve.append((day_str, round(equity_before_management, 2)))
                start_of_day_equity = equity_before_management
                continue
 
            # ---- 1. Manage existing positions (DTE backstop, then
            #         profit-capture, then stop-loss — same precedence as
            #         the live engine's monitor_exit_targets()) ----
            for sym, pos in self.positions.items():
                if not pos.active or day_str not in idx_lookup[sym]:
                    continue
                series = self.symbol_series[sym]
                i = idx_lookup[sym][day_str]
                _, close = series[i]
                vol = self.symbol_vol[sym][i] or 0.20
 
                calendar_days_left = max((pos.expiry_day_index - i) / TRADING_DAYS_PER_CALENDAR_DAY, 0.5)
                theo_price = calculate_black_scholes_value(close, pos.strike, calendar_days_left, RISK_FREE_RATE, vol)
 
                reason = None
                if i >= pos.dte_backstop_day_index:
                    reason = "DTE_BACKSTOP"
                elif theo_price <= pos.entry_credit * TAKE_PROFIT_PCT:
                    reason = "PROFIT_CAPTURE"
                elif theo_price >= pos.entry_credit * STOP_LOSS_MULTIPLE:
                    reason = "STOP_LOSS"
                elif i >= pos.expiry_day_index:
                    reason = "EXPIRED"  # safety net; DTE backstop should always fire first
 
                if reason:
                    self._close_position(sym, day_str, close, theo_price, reason)
 
            # ---- 2. New-position scan — cash-only, even split across
            #         every symbol that qualifies this pass, same as the
            #         live engine's evaluate_new_position_opportunities() /
            #         attempt_new_buy_write(). No EOD flatten anywhere in
            #         this file — positions simply carry to the next
            #         trading day. ----
            eligible = []
            for sym, pos in self.positions.items():
                if pos.active or day_str not in idx_lookup[sym]:
                    continue
                series = self.symbol_series[sym]
                i = idx_lookup[sym][day_str]
                _, close = series[i]
                vol = self.symbol_vol[sym][i]
                if vol is None or close <= 0:
                    continue
 
                solved_strike = solve_strike_for_target_delta(close, TARGET_DTE_DAYS, RISK_FREE_RATE, vol, TARGET_DELTA)
                strike = solved_strike if solved_strike is not None else close * 1.02
                theo = calculate_black_scholes_value(close, strike, TARGET_DTE_DAYS, RISK_FREE_RATE, vol)
                if theo <= 0:
                    continue
                annualized_yield = (theo / close) * (365.0 / TARGET_DTE_DAYS)
                eligible.append((sym, i, close, strike, theo, annualized_yield))
 
            eligible.sort(key=lambda c: c[5], reverse=True)
 
            candidates_remaining = len(eligible)
            for sym, i, close, strike, theo, ayield in eligible:
                # Even-split of whatever cash is left THIS PASS across
                # however many candidates remain to be tried — same logic
                # as attempt_new_buy_write()'s candidates_remaining
                # countdown, never margin.
                if self.cash <= MIN_CASH_BUFFER:
                    candidates_remaining -= 1
                    continue
                allocation = min(self.cash / max(candidates_remaining, 1), self.cash)
                shares_affordable = int(allocation // (close * 100)) * 100
                candidates_remaining -= 1
                if shares_affordable < 100:
                    continue
 
                contracts = shares_affordable // 100
                cost = shares_affordable * close
                credit = theo * 100 * contracts
 
                pos = self.positions[sym]
                trading_day_offset_to_expiry = max(int(TARGET_DTE_DAYS * TRADING_DAYS_PER_CALENDAR_DAY), 1)
                dte_backstop_offset = max(int(trading_day_offset_to_expiry * (1.0 - DTE_BACKSTOP_PCT)), 1)
                series = self.symbol_series[sym]
 
                pos.active = True
                pos.shares = shares_affordable
                pos.contracts = contracts
                pos.cost_basis_per_share = close
                pos.strike = strike
                pos.entry_credit = theo
                pos.expiry_day_index = min(i + trading_day_offset_to_expiry, len(series) - 1)
                pos.dte_backstop_day_index = min(i + dte_backstop_offset, len(series) - 1)
 
                self.cash -= cost
                self.cash += credit
                self._log_trade(sym, day_str, "OPEN_BUY_WRITE", contracts, strike, theo, credit - cost)
 
            final_equity = self._mark_to_market(day_str, idx_lookup)
            self.equity_curve.append((day_str, round(final_equity, 2)))
            start_of_day_equity = final_equity
 
        self._write_outputs()
        self._print_summary()
 
    def _mark_to_market(self, day_str, idx_lookup):
        total = self.cash
        for sym, pos in self.positions.items():
            if pos.shares > 0 and day_str in idx_lookup[sym]:
                i = idx_lookup[sym][day_str]
                _, close = self.symbol_series[sym][i]
                total += pos.shares * close
        return total
 
    def _close_position(self, sym, day_str, close_price, buyback_price, reason):
        """RECYCLE, not roll: sells the shares AND buys back the call, same
        as the live engine's recycle_symbol_after_close(). Both legs'
        cash flows are applied and both are combined into the logged P&L —
        this is a full round-trip exit, not just an option buy-to-close."""
        pos = self.positions[sym]
 
        option_buyback_cost = buyback_price * 100 * pos.contracts
        stock_sale_proceeds = close_price * pos.shares
 
        self.cash -= option_buyback_cost
        self.cash += stock_sale_proceeds
 
        stock_pnl = (close_price - pos.cost_basis_per_share) * pos.shares
        option_pnl = (pos.entry_credit - buyback_price) * 100 * pos.contracts
        total_pnl = stock_pnl + option_pnl
 
        self._log_trade(sym, day_str, reason, pos.contracts, pos.strike, buyback_price, total_pnl)
 
        pos.active = False
        pos.shares = 0
        pos.contracts = 0
 
    def _log_trade(self, sym, day_str, event, contracts, strike, credit_or_debit, pnl):
        self.trade_log.append({
            "date": day_str, "symbol": sym, "event": event, "contracts": contracts,
            "strike": round(strike, 2), "credit_or_debit": round(credit_or_debit, 4), "pnl": round(pnl, 2),
        })
 
    def _write_outputs(self):
        with open(TRADE_LOG_CSV_PATH, "w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=["date", "symbol", "event", "contracts", "strike", "credit_or_debit", "pnl"])
            writer.writeheader()
            writer.writerows(self.trade_log)
        with open(EQUITY_CURVE_CSV_PATH, "w", newline="", encoding="utf-8") as f:
            writer = csv.writer(f)
            writer.writerow(["date", "equity"])
            writer.writerows(self.equity_curve)
 
    def _print_summary(self):
        if not self.equity_curve:
            print("⚠️ No equity curve generated — check that historical data actually loaded.")
            return
 
        final_equity = self.equity_curve[-1][1]
        total_return_pct = (final_equity - STARTING_CAPITAL) / STARTING_CAPITAL * 100
        years = (BACKTEST_END - BACKTEST_START).days / 365.25
        cagr = ((final_equity / STARTING_CAPITAL) ** (1 / years) - 1) * 100 if years > 0 and final_equity > 0 else 0.0
 
        peak = STARTING_CAPITAL
        max_dd = 0.0
        for _, eq in self.equity_curve:
            peak = max(peak, eq)
            if peak > 0:
                max_dd = max(max_dd, (peak - eq) / peak)
 
        close_events = ("PROFIT_CAPTURE", "STOP_LOSS", "DTE_BACKSTOP", "EXPIRED")
        closes = [t for t in self.trade_log if t["event"] in close_events]

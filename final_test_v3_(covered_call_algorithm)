    BENIGN_INFO_CODES = {1100, 1101, 1102, 2103, 2104, 2105, 2106, 2107, 2108, 2119, 2137, 2158, 10349}
 
    def error(self, reqId, errorCode, errorString, advancedOrderRejectJson=""):
        if reqId in self.pending_order_cash:
            freed = self.pending_order_cash.pop(reqId)
            note = f"↩️ Released ${freed:,.2f} cash reservation for order {reqId} after error/rejection (code {errorCode})."
            print(note)
            self.write_to_notepad(note)
 
        # FIX (bare/orphaned shares): IB sometimes reports an order-level
        # rejection through error() rather than an orderStatus() status
        # change. If this reqId is a LIQUIDATE_SHARES order, clear its
        # "currently working" flag so sweep_orphaned_shares() knows it's
        # free to retry on the next pass.
        if self.order_intents.get(reqId) == "LIQUIDATE_SHARES":
            liq_sym = self.order_symbol.get(reqId)
            if liq_sym and liq_sym in self.liquidation_pending_symbols:
                self.liquidation_pending_symbols.discard(liq_sym)
                note = f"↩️ {liq_sym}: liquidation order {reqId} errored (code {errorCode}) — the orphan sweep will retry it."
                print(note)
                self.write_to_notepad(note)
 
        if errorCode in self.BENIGN_INFO_CODES:
            print(f"ℹ️ [{errorCode}] {errorString}")
            return
        if errorCode == 201:
            msg = (
                f"🚫 IB ERROR [reqId={reqId}] Code 201: {errorString} — ACCOUNT PERMISSION setting. "
                f"Set STANDALONE_COVERED_CALL_PERMISSION_GRANTED=True once IB confirms the permission."
            )
        elif errorCode == 321:
            msg = f"🚫 IB ERROR [reqId={reqId}] Code 321: {errorString} — missing exchange or conId."
        else:
            msg = f"⚠️ IB ERROR [reqId={reqId}] Code {errorCode}: {errorString}"
        print(msg)
        self.write_to_notepad(msg)
 

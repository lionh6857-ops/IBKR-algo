class CoveredCallEngine(EWrapper, EClient):
    """
    LEVEL 1 OPTIONS STRATEGY: COVERED CALL.

    This engine SELLS (writes) a SPY call against SPY shares you already own
    in the account. It never buys options outright and never writes a call
    unless it has confirmed, via reqPositions(), that enough real shares are
    held to cover it (100 shares per contract). This is what keeps the
    order within Level 1 permissions instead of tripping the "no trading
    permissions for this options strategy" rejection.

    IMPORTANT: this engine does NOT buy the underlying shares for you. It
    only checks what you already hold. If you don't hold at least 100
    shares of SPY in this paper account, it will sit idle and tell you so.
    """

    def __init__(self):
        EClient.__init__(self, self)
        self.next_order_id = None
        self.live_stock_price = 0.0
        self.live_option_ask = 0.0
        self.live_option_bid = 0.0
        self.contract_resolved = False
        self.chain_contracts = []   # accumulated SPY option chain from reqContractDetails
        self.has_executed = False

        self.heartbeat_count = 0

        # 🛡️ POSITION STATUS INDICATORS (short call = the position we've written)
        self.position_active = False
        self.entry_credit = 0.0        # premium per share received when we sold the call
        self.take_profit_target = 0.0  # buy back when option price DROPS to this
        self.stop_loss_target = 0.0    # buy back when option price RISES to this
        self.position_quantity = 0

        # 📦 SHARE POSITION (the actual "cover" for the covered call)
        self.spy_shares_owned = 0
        self.shares_position_ready = False  # gate: don't evaluate until we've confirmed real holdings

        # 🎯 STRATEGY TUNING
        self.risk_per_trade_pct = 0.01     # 1% of capital at risk per trade
        self.take_profit_pct = 0.50        # close once option value decays to 50% of credit received
        self.stop_loss_multiple = 2.0      # close if option value rises to 2x credit received (adverse rally)
        self.call_otm_offset = 10.0        # write calls this many $ above the at-the-money strike

        # 📈 PERFORMANCE TRACKING STATS
        self.starting_balance = 0.0
        self.closing_balance = 0.0
        self.account_balance_ready = False   # gate: don't trade until we know real cash capital
        self.total_trades = 0
        self.wins = 0
        self.session_history = self.load_session_history()

        # 🚨 RISK PARAMETER BOUNDARIES
        self.max_daily_drawdown_pct = 0.02
        self.max_daily_markup_pct = 0.03
        self.system_halted = False

        # 🧾 ORDER INTENT TRACKING
        # Bug fix vs. the long-call version: that version matched fills using
        # "orderId == self.next_order_id", which breaks the moment a second
        # order (the exit) reuses/advances next_order_id — a closing fill
        # could get misread as a brand-new opening fill. Instead we tag every
        # order we submit with its purpose up front and look it up by ID.
        self.order_intents = {}  # order_id -> "OPEN" or "CLOSE"

    # ---------------------------------------------------------------
    # SESSION HISTORY PERSISTENCE
    # ---------------------------------------------------------------
    def load_session_history(self):
        if not os.path.exists(SESSION_HISTORY_PATH):
            return []
        try:
            with open(SESSION_HISTORY_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, OSError):
            return []

    def save_session_history(self):
        try:
            with open(SESSION_HISTORY_PATH, "w", encoding="utf-8") as f:
                json.dump(self.session_history, f, indent=2)
        except OSError as e:
            print(f"⚠️ Could not write session history: {e}")

    def append_todays_session(self):
        entry = {
            "date": datetime.datetime.now().strftime("%Y-%m-%d"),
            "starting_cash": self.starting_balance,
            "closing_cash": self.closing_balance,
            "trades": self.total_trades,
            "wins": self.wins,
            "net_pl": round(self.closing_balance - self.starting_balance, 2),
        }
        self.session_history.append(entry)
        self.save_session_history()


class OptionLeg:
    """Tracks ONE short call beyond the "primary" leg on a symbol."""

    def __init__(self, contract, quantity, entry_credit, entry_days_to_expiry=0.0):
        self.contract = contract
        self.position_quantity = quantity
        self.entry_credit = entry_credit
        self.take_profit_target = 0.0
        self.stop_loss_target = 0.0
        # DTE this leg had when first ACTUALLY opened — the fixed
        # reference point DTE_BACKSTOP_PCT is measured against. Never
        # updated after the fact; only the LIVE remaining DTE (recomputed
        # fresh each check) moves. Recovered from the persisted ledger on
        # restart when available — see positionEnd().
        self.entry_days_to_expiry = entry_days_to_expiry
        self.live_option_bid = 0.0
        self.live_option_ask = 0.0
        self.data_reqid = None
        self.position_active = True


class SymbolState:
    def __init__(self, symbol, category="existing_holding", is_existing_holding=True):
        self.symbol = symbol
        self.category = category
        self.is_existing_holding = is_existing_holding

        self.shares_owned = 0
        self.stock_conid = None          # resolved once via contract lookup (no market data)
        self.target_option = None        # the PRIMARY short call leg, if any
        self.chain_contracts = []
        self.contract_resolved = False
        self.has_executed = False

        self.live_stock_price = 0.0
        self.live_option_bid = 0.0
        self.live_option_ask = 0.0
        self.implied_vol = 0.0
        self.days_to_expiry = 8.0
        # DTE the PRIMARY leg had when the current position was ACTUALLY
        # opened — fixed reference point for the DTE backstop. Set once at
        # true entry, never touched afterward. Recovered from the
        # persisted entry-DTE ledger on restart when this exact contract
        # (by conId) is found there — see positionEnd() and
        # ENTRY_DTE_LEDGER_PATH above. Only falls back to "whatever DTE is
        # left today" if the ledger has no record for this conId (e.g.
        # this script has never managed this exact contract before).
        self.entry_days_to_expiry = 0.0

        self.position_active = False
        self.entry_credit = 0.0
        self.position_quantity = 0
        self.take_profit_target = 0.0
        self.stop_loss_target = 0.0

        self.data_reqid = None
        self.chain_reqid = None
        self.stock_conid_reqid = None

        # Ranking metrics, recomputed every scan pass
        self.bs_edge = 0.0
        self.annualized_yield = 0.0

        # True once this symbol's shares were bought BY THIS BOT via a
        # buy-write combo, as opposed to being a pre-existing holding
        # discovered on startup.
        self.opened_by_bot = False
        # Avoids re-logging the same Code-201 permission warning every
        # heartbeat for a symbol that already has a live signal queued.
        self.permission_warned = False

        # Any short calls on this symbol BEYOND the primary one
        # (self.target_option) — see OptionLeg.
        self.other_option_legs = []


class BuyWriteBasketEngine(EWrapper, EClient):
    """
    Autonomous covered-call ("buy-write") basket engine — Magnificent
    Seven only, quant-style long-term/profit-capture exit logic.

    IMPORTANT CAVEATS, read before trusting this with capital:
    - New-position buy-writes are submitted as combo (BAG) orders so both
      legs go in as one transaction rather than sequential trades. This
      reduces legging risk but does NOT guarantee true simultaneous fills.
    - execDetails() accumulates every partial fill per leg and only
      finalizes bookkeeping once BOTH legs have filled their FULL expected
      size — see execDetails() for why that matters on multi-lot combos.
    - self.closing_balance is a LIVE feed of IB's own NetLiquidation value
      (whole portfolio: cash + every stock/option position), updated on
      every accountSummary() callback. Nothing in this file adds or
      subtracts from it manually — IB's own number already reflects every
      fill and price tick in real time.
    - self.current_cash is a SEPARATE live feed of TotalCashValue. This is
      what actually limits buying new shares.
    - self.excess_liquidity is a live feed of IB's own ExcessLiquidity
      figure — IB's authoritative "how much more you could commit before
      you'd be on margin" number. Both this and self.current_cash are
      watched by enforce_cash_solvency() every heartbeat; if either goes
      negative the engine halts new trades and starts closing positions.
      See the CASH-ONLY ENFORCEMENT note above.
    - self.pending_order_cash reserves the estimated cost of every
      buy-write combo THE INSTANT it's submitted, and only releases that
      reservation once execDetails() confirms the fill or the order is
      cancelled/rejected. Available cash for a NEW trade is always
      current_cash minus everything still reserved.
    - ALL order ids submitted to IB must come from allocate_order_id().
      Do not read/write self.next_order_id directly anywhere else.
    - Code 201 ("no trading permissions for this options strategy") on a
      standalone sell-to-open order is an IBKR ACCOUNT PERMISSION gap, not
      a code bug. Fix it in Account Management -> Settings -> Trading
      Permissions -> Options, then flip STANDALONE_COVERED_CALL_PERMISSION_
      GRANTED to True.
    - Contract objects that arrive via IB's position() stream do not
      reliably have `exchange` populated, which produces Code 321 "Please
      enter exchange" rejections on reqMktData. Those contracts get
      exchange forced to "SMART" before any data request goes out.
    - reqSecDefOptParams (the option-expiration lookup) requires the
      underlying's REAL, resolved IB conId — passing a placeholder/0
      value produces Code 321 "Invalid contract id" for EVERY symbol.
      start_chain_lookup() is now ONLY ever called after
      contractDetailsEnd() has confirmed a real conId came back from
      start_stock_conid_lookup(); nothing calls it directly anymore.
    - A buy-write combo ALREADY writes a covered call as part of the same
      order. execDetails() marks state.has_executed = True on combo fill
      finalize for exactly this reason.
    - Option expirations are chosen DYNAMICALLY (see start_chain_lookup /
      choose_target_expiration), not hardcoded to a contract month.
    - STRIKE SELECTION is delta-targeted (see solve_strike_for_target_delta
      and finalize_target_contract), not a flat OTM percentage — each
      symbol's own live implied vol determines which strike lands closest
      to TARGET_DELTA.
    - MULTI-LEG POSITIONS: if a symbol has more than one existing short
      call, every call beyond the first ("primary") is tracked as its own
      OptionLeg with independent monitoring, exit-target tracking, and
      assignment reconciliation — see positionEnd(), monitor_leg_exit_targets(),
      trigger_close_leg_payload().
    - ODD LOTS: every discovered share position gets a SymbolState now,
      not just ones with >=100 shares. MIN_SHARES_FOR_COVER still gates
      whether a NEW call can be written against a position; it does not
      gate whether the position is tracked/monitored at all.
    - RESTART / RECONNECT RECOVERY: on startup, reqOpenOrders() (see
      reconcile_open_orders/openOrder) rebuilds order_intents/order_symbol/
      combo_leg_fills for anything still working with IB from before this
      process started or restarted. openOrderEnd() then calls
      reqExecutions() to replay today's fills back through the existing
      execDetails() accumulator. Positions that fully settled before a
      restart are recovered via reqPositions().
    - ENTRY-DTE LEDGER (see ENTRY_DTE_LEDGER_PATH, load_entry_dte_ledger/
      record_entry_dte/pop_entry_dte): this is what lets a position's DTE
      backstop reference point survive being shut down and restarted —
      including a routine nightly shutdown, which is the expected way to
      run this (no point burning power/API connections while markets are
      closed). The TRUE entry DTE is recorded, keyed by the option
      contract's conId, the instant a position is actually opened
      (execDetails()/orderStatus()), and looked up again in positionEnd()
      whenever that same contract is rediscovered on a later (re)start —
      instead of positionEnd() falling back to "whatever DTE is left
      today," which would silently move the DTE-backstop trip point every
      time the script restarted. The ledger entry is removed the moment
      that position closes (see trigger_close_covered_call_payload() /
      trigger_close_leg_payload()), so it never grows unbounded. The
      fallback ("whatever DTE is left today") is only ever used the very
      first time this script encounters a given contract with no ledger
      record for it at all — e.g. a position that existed on the account
      before this script (or this version of it) ever ran.
    - This engine only ever writes covered calls (buy-write) — it does not
      hold plain, uncapped long stock positions as a separate strategy
      mode. Every position it opens has a call written against it.
    - CASH-ONLY ENFORCEMENT: see the CASH ALLOCATION constant block above
      and enforce_cash_solvency()/close_largest_position_for_solvency()
      below.
    - CONCENTRATION: no cap on how many of the 7 candidate symbols can be
      open at once.
    - EXIT STYLE: no forced end-of-day flatten, no plain calendar-day
      close rule. Every open position is held until ONE of three
      independent triggers fires: profit-capture (PROFIT_CAPTURE_PCT),
      stop-loss (self.stop_loss_multiple), or the DTE backstop
      (DTE_BACKSTOP_PCT), whichever comes first.
    """

    def __init__(self):
        EClient.__init__(self, self)
        self.next_order_id = None
        self.heartbeat_count = 0

        self.symbol_states = {}
        self.reqid_to_symbol = {}
        self.chain_reqid_to_symbol = {}
        self.stock_conid_reqid_to_symbol = {}
        self.secdef_reqid_to_symbol = {}     # reqSecDefOptParams reqid -> symbol
        self._pending_expirations = {}       # symbol -> set of 'YYYYMMDD' strings, accumulated across exchanges
        self.extra_leg_reqid_to_leg = {}     # reqid -> (symbol, OptionLeg) for legs beyond the primary
        self.order_symbol = {}
        self.order_intents = {}
        self.order_leg = {}         # order_id -> OptionLeg, for CLOSE_EXTRA_LEG orders
        self.combo_leg_fills = {}   # order_id -> accumulated per-leg fill totals, see trigger_buy_write_combo
        self._next_reqid = 100
        self._account_summary_reqid = 9001

        self._discovered_shares = {}
        self._discovered_share_avgcost = {}
        self._discovered_short_calls = {}
        self._initial_snapshot_done = False

        # 🗓️ ENTRY-DTE LEDGER — persisted to disk, survives restarts. See
        # ENTRY_DTE_LEDGER_PATH and the class docstring note above.
        self.entry_dte_ledger = self.load_entry_dte_ledger()

        # 🎯 STRATEGY TUNING
        self.risk_per_trade_pct = 0.01
        # Derived from PROFIT_CAPTURE_PCT (see the constant block above):
        # a position closes once the option's live ask has decayed down to
        # this fraction of the entry credit — i.e. PROFIT_CAPTURE_PCT of
        # the max possible profit has already been captured. This is a
        # price/decay condition, not a day-count, so it naturally adapts
        # to however fast or slow theta actually plays out on each name.
        self.take_profit_pct = round(1.0 - PROFIT_CAPTURE_PCT, 4)
        self.stop_loss_multiple = 2.0
        # Delta target for strike selection — see solve_strike_for_target_delta
        # and finalize_target_contract(). Replaces the old flat OTM % rule.
        self.target_delta = TARGET_DELTA

        # 💵 NEW-POSITION CAPITAL ALLOCATION — deploys ALL available liquid
        # cash during market hours, split evenly across however many
        # symbols show a qualifying signal this pass (see
        # attempt_new_buy_write()). No concentration cap and no separate
        # per-trade cash cap — cash-solvency enforcement and the
        # per-position stop-loss are the risk backstops instead.
        self.new_positions_opened_today = 0
        # Tracks cash already committed to orders placed EARLIER IN THE
        # SAME evaluate_new_position_opportunities() scan pass, before
        # their fills come back through execDetails().
        self._cash_earmarked_this_pass = 0.0
        # order_id -> estimated cash cost, reserved the INSTANT a buy-write
        # combo is submitted and held until execDetails() confirms the
        # fill or the order is cancelled/rejected. Persists ACROSS
        # heartbeats (unlike _cash_earmarked_this_pass above).
        self.pending_order_cash = {}
        # True whenever cash or IB's ExcessLiquidity has gone negative
        # (i.e. a fill went through on margin). While True: no new
        # positions open, still-working buy-write orders get cancelled,
        # and existing bot positions are closed down until solvent again.
        # See enforce_cash_solvency().
        self.cash_solvency_halt = False
        # Recomputed from broker position data (shares x avgCost) for
        # symbols THIS BOT opened. Reporting-only — sizing is capped by
        # live current_cash, see attempt_new_buy_write().
        self.committed_capital = 0.0

        # 📈 ACCOUNT-WIDE TRACKING
        # starting_balance / closing_balance = NET LIQUIDATION (whole
        # portfolio), a LIVE feed from accountSummary().
        self.starting_balance = 0.0
        self.closing_balance = 0.0
        # starting_cash / current_cash = ACTUAL SPENDABLE CASH, tracked
        # separately — this is what genuinely limits new positions.
        self.starting_cash = 0.0
        self.current_cash = 0.0
        # excess_liquidity = IB's own live ExcessLiquidity figure.
        self.excess_liquidity = 0.0
        self.excess_liquidity_ready = False
        self.account_balance_ready = False
        self.shares_position_ready = False
        self.total_trades = 0
        self.wins = 0
        self.session_history = self.load_session_history()

        # 🎲 RISK KNOBS
        self.max_daily_drawdown_pct = 0.08
        self.max_daily_markup_pct = 0.15
        self.system_halted = False

    def allocate_reqid(self):
        self._next_reqid += 1
        return self._next_reqid

    def allocate_order_id(self):
        """Single source of truth for outgoing order ids. Every placeOrder()
        call in this class MUST get its id from here — never read or
        increment self.next_order_id anywhere else."""
        order_id = self.next_order_id
        self.next_order_id += 1
        return order_id

    def available_cash_for_new_trades(self):
        """Actual spendable cash for a NEW position: live TotalCashValue
        minus everything already reserved for orders still working, either
        earlier in this SAME scan pass (_cash_earmarked_this_pass) or
        still outstanding from an EARLIER heartbeat (pending_order_cash)."""
        reserved = sum(self.pending_order_cash.values()) + self._cash_earmarked_this_pass
        return self.current_cash - reserved

    def count_active_positions(self):
        """Number of DISTINCT symbols with any open covered-call exposure
        right now (primary leg active, OR any additional OptionLeg
        active). No concentration cap is enforced against this anymore —
        kept purely for status logging."""
        count = 0
        for state in self.symbol_states.values():
            if state.position_active or any(leg.position_active for leg in state.other_option_legs):
                count += 1
        return count

    def build_position_snapshot_lines(self):
        """Human-readable, one-line-per-symbol breakdown of every share
        and option leg still open right now."""
        lines = []
        for sym, state in sorted(self.symbol_states.items()):
            has_shares = state.shares_owned > 0
            has_primary = state.position_active
            has_extra = any(leg.position_active for leg in state.other_option_legs)
            if not (has_shares or has_primary or has_extra):
                continue

            parts = []
            if has_shares:
                share_value = state.shares_owned * state.live_stock_price
                parts.append(f"{state.shares_owned} sh @ ${state.live_stock_price:,.2f} (${share_value:,.2f})")

            if has_primary:
                live_dte = self.compute_days_to_expiry(state.target_option)
                unrealized = round((state.entry_credit - state.live_option_ask) * 100.0 * state.position_quantity, 2)
                parts.append(
                    f"short {state.position_quantity}x ${state.target_option.strike} call "
                    f"(credit ${state.entry_credit}, now ${state.live_option_ask}, {live_dte:.1f}d left, "
                    f"unrealized {'+' if unrealized >= 0 else ''}${unrealized:,.2f})"
                )

            for leg in state.other_option_legs:
                if not leg.position_active:
                    continue
                live_dte = self.compute_days_to_expiry(leg.contract)
                unrealized = round((leg.entry_credit - leg.live_option_ask) * 100.0 * leg.position_quantity, 2)
                parts.append(
                    f"short {leg.position_quantity}x ${leg.contract.strike} call [{leg.contract.localSymbol}] "
                    f"(credit ${leg.entry_credit}, now ${leg.live_option_ask}, {live_dte:.1f}d left, "
                    f"unrealized {'+' if unrealized >= 0 else ''}${unrealized:,.2f})"
                )

            lines.append(f"   {sym}: " + " | ".join(parts))
        return lines


    # ---------------------------------------------------------------
    # ENTRY-DTE LEDGER PERSISTENCE (survives restarts — see
    # ENTRY_DTE_LEDGER_PATH and the class docstring note)
    # ---------------------------------------------------------------
    def load_entry_dte_ledger(self):
        if not os.path.exists(ENTRY_DTE_LEDGER_PATH):
            return {}
        try:
            with open(ENTRY_DTE_LEDGER_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, OSError):
            return {}

    def save_entry_dte_ledger(self):
        try:
            with open(ENTRY_DTE_LEDGER_PATH, "w", encoding="utf-8") as f:
                json.dump(self.entry_dte_ledger, f, indent=2)
        except OSError as e:
            print(f"⚠️ Could not write entry-DTE ledger: {e}")

    def record_entry_dte(self, con_id, entry_days_to_expiry):
        """Called the instant a position is ACTUALLY opened (combo fill in
        execDetails(), or a standalone open fill in orderStatus()) — or,
        as a one-time best-effort fallback, the first time positionEnd()
        discovers a contract with no existing ledger record at all. Keyed
        by conId so it's specific to this exact strike+expiry+right, not
        just the underlying symbol."""
        if not con_id:
            return
        self.entry_dte_ledger[str(con_id)] = {
            "entry_days_to_expiry": entry_days_to_expiry,
            "recorded_on": datetime.datetime.now().strftime("%Y-%m-%d"),
        }
        self.save_entry_dte_ledger()

    def pop_entry_dte(self, con_id):
        """Removes a ledger entry once its position has closed, so the
        file doesn't grow unbounded and a later, unrelated contract that
        happens to reuse a conId (won't normally happen, but cheap
        insurance) never inherits a stale entry DTE."""
        if not con_id:
            return
        key = str(con_id)
        if key in self.entry_dte_ledger:
            del self.entry_dte_ledger[key]
            self.save_entry_dte_ledger()

